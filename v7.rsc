/system script remove [find name="backup-to-fs"]
/system scheduler remove [find name="weekly-backup-fs"]
/system ntp client set enabled=yes
/system ntp client servers remove [find]
/system ntp client servers add address=<NTP_PRIMARY>
/system ntp client servers add address=<NTP_SECONDARY>
/system script add name="backup-to-fs" policy=read,write,test,sensitive,ftp source=":log info \"BACKUP: 1. Script started\"; :local fsHost \"<FS_HOST>\"; :local fsUser \"<FS_USER>\"; :local fsPass \"<FS_PASS>\"; :local backupPass \"<BACKUP_PASS>\"; :local dateStr [/system clock get date]; :local remoteDir \"\"; :foreach c in=[:toarray \$dateStr] do={ :if (\$c = \"/\") do={ :set remoteDir (\$remoteDir . \"-\") } else={ :set remoteDir (\$remoteDir . \$c) } }; :local devName [/system identity get name]; :local base (\$devName . \"_\" . \$remoteDir); :log info (\"BACKUP: 2. Filename: \" . \$base); :log info (\"BACKUP: 3. Destination folder: \" . \$remoteDir); /system backup save name=\$base password=\$backupPass; /export file=\$base; :log info \"BACKUP: 4. Files are being created, waiting 3 seconds...\"; :delay 3s; :if ([:len [/file find name=(\$base . \".backup\")]] = 0) do={ :log error \"BACKUP: ERROR! Local file .backup was not created!\"; } else={ :log info \"BACKUP: 5. Local file .backup created successfully\" }; :if ([:len [/file find name=(\$base . \".rsc\")]] = 0) do={ :log error \"BACKUP: ERROR! Local file .rsc was not created!\"; } else={ :log info \"BACKUP: 6. Local file .rsc created successfully\" }; :log info (\"BACKUP: 7. Uploading .backup to path: \" . \$remoteDir . \"/\" . \$base . \".backup\"); /tool fetch upload=yes address=\$fsHost port=21 mode=ftp user=\$fsUser password=\$fsPass src-path=(\$base . \".backup\") dst-path=(\$remoteDir . \"/\" . \$base . \".backup\"); :log info (\"BACKUP: 8. Uploading .rsc to path: \" . \$remoteDir . \"/\" . \$base . \".rsc\"); /tool fetch upload=yes address=\$fsHost port=21 mode=ftp user=\$fsUser password=\$fsPass src-path=(\$base . \".rsc\") dst-path=(\$remoteDir . \"/\" . \$base . \".rsc\"); :log info \"BACKUP: 9. Success! Removing local files\"; /file remove [find name=(\$base . \".backup\")]; /file remove [find name=(\$base . \".rsc\")]; :log info \"BACKUP: 10. Script completed successfully!\""
/system scheduler add name="weekly-backup-fs" start-date=oct/28/2026 start-time=03:00:00 interval=7d on-event="/system script run backup-to-fs" comment="Backup every Wednesday starting 28 Oct 2026"
/system script run backup-to-fs